# Copy to .env; never commit real secrets.
AI_AGENT_DEBUG=false
AI_AGENT_HOST=127.0.0.1
AI_AGENT_PORT=8000
AI_AGENT_WORKSPACE_ROOT=E:\COMSOL62\Multiphysics\eg\AI agent-1
AI_AGENT_STATE_DIR=state
AI_AGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AI_AGENT_BASE_URL=https://api.openai.com/v1
AI_AGENT_API_KEY=
AI_AGENT_MODEL=gpt-4o-mini
AI_AGENT_TEMPERATURE=0.2
AI_AGENT_MAX_TOKENS=
AI_AGENT_FALLBACK_ROUTES_JSON=[]

AI_AGENT_MAX_AGENT_STEPS=8
AI_AGENT_MAX_REPEATED_TOOL_CALLS=2
AI_AGENT_TOOL_TIMEOUT_SECONDS=30
AI_AGENT_MAX_PARALLEL_TOOLS=8
AI_AGENT_SHORT_TERM_MESSAGE_LIMIT=24
AI_AGENT_SHORT_TERM_CHAR_BUDGET=24000
AI_AGENT_RAG_TOP_K=6

# Offline deterministic baseline or OpenAI-compatible embeddings.
AI_AGENT_EMBEDDING_PROVIDER=hash
AI_AGENT_EMBEDDING_MODEL=text-embedding-3-small

# sqlite is self-contained; qdrant requires: uv sync --extra vector
AI_AGENT_VECTOR_BACKEND=sqlite
AI_AGENT_QDRANT_URL=http://localhost:6333
AI_AGENT_QDRANT_COLLECTION=agent_documents
